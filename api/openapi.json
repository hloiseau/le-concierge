{
  "openapi": "3.0.3",
  "info": {
    "title": "Le Concierge API",
    "version": "0.3.0",
    "description": "Plex-authenticated Hub API. Private routes require a verified Plex session with access to the configured server. Discord linking is optional. Cookies are HttpOnly; provider tokens never reach the browser."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "getServices",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Services"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests": {
      "get": {
        "operationId": "getRequests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestPage"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/recent": {
      "get": {
        "operationId": "getRecent",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recent"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/preferences": {
      "get": {
        "operationId": "getPreferences",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePreferences",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceUpdate"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/plex/start": {
      "post": {
        "operationId": "startPlexLogin",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexStart"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ],
        "description": "Anonymous Plex PIN flow; exact Origin required. The pending PIN is bound to a dedicated HttpOnly browser cookie. A session is issued only after Plex verifies access to the configured server."
      }
    },
    "/api/v1/auth/plex/poll": {
      "post": {
        "operationId": "pollPlexLogin",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexPoll"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ],
        "description": "Anonymous Plex PIN flow; exact Origin required. The pending PIN is bound to a dedicated HttpOnly browser cookie. A session is issued only after Plex verifies access to the configured server."
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/discord/start": {
      "get": {
        "operationId": "startDiscord",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Discord or Hub; callback requires single-use state and the initiating browser cookie."
          },
          "default": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Link Discord to the current verified Plex account. The OAuth attempt is bound to the initiating live session."
      }
    },
    "/api/v1/auth/discord/callback": {
      "get": {
        "operationId": "callbackDiscord",
        "security": [],
        "responses": {
          "303": {
            "description": "Redirect to Discord or Hub; callback requires single-use state and the initiating browser cookie."
          },
          "default": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Consume the one-time state and its browser cookie, verify the initiating Plex session is still valid, link the Discord identity, rotate the session cookie. Does not grant Hub access on its own."
      }
    },
    "/api/v1/departures": {
      "get": {
        "operationId": "getDepartures",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Departures"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Current Plex user only. Recorded viewing history and season/show parents within 30 days. Checks active rules, exclusions and current per-item Plex access. Missing history and whole-season completion remain unknown. No query parameters or automatic reminders."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-concierge_session",
        "description": "HttpOnly cookie; concierge_session for loopback development only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "discordId": {
            "type": "string",
            "description": "Optional Discord identity, linked after Plex login."
          },
          "name": {
            "type": "string"
          },
          "plexId": {
            "type": "string"
          },
          "seerrId": {
            "type": "integer"
          },
          "notifications": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "plexId",
          "notifications"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true
          },
          "admin": {
            "type": "boolean"
          },
          "plexConnected": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user"
        ]
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "watch",
              "read",
              "tools"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category"
        ]
      },
      "Services": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "discordLogin": {
            "type": "boolean",
            "description": "Optional Discord account linking is configured; this does not authenticate access to the Hub."
          },
          "plexLink": {
            "type": "boolean",
            "description": "Plex sign-in is configured and required to enter the Hub."
          },
          "requests": {
            "type": "boolean"
          },
          "recent": {
            "type": "boolean"
          },
          "subscriptions": {
            "type": "boolean"
          },
          "notifications": {
            "type": "boolean"
          },
          "books": {
            "type": "boolean"
          },
          "monitoring": {
            "type": "boolean"
          },
          "departures": {
            "type": "boolean",
            "description": "Personal recorded viewing history; automatic reminders remain separate."
          }
        },
        "required": [
          "version",
          "discordLogin",
          "plexLink",
          "requests",
          "recent",
          "subscriptions",
          "notifications",
          "books",
          "monitoring"
        ]
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "addedAt"
        ]
      },
      "Recent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "offset",
          "limit",
          "updatedAt"
        ]
      },
      "MediaRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "declined",
              "processing",
              "partial",
              "available",
              "unknown"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "mediaId": {
            "type": "integer"
          },
          "seasons": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "status",
          "createdAt",
          "mediaId",
          "seasons"
        ]
      },
      "RequestPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaRequest"
            }
          },
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "notifications": {
            "type": "boolean"
          },
          "notificationsAvailable": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "notifications",
          "notificationsAvailable",
          "timezone"
        ]
      },
      "PreferenceUpdate": {
        "type": "object",
        "properties": {
          "notifications": {
            "type": "boolean"
          }
        },
        "required": [
          "notifications"
        ]
      },
      "PlexStart": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "url",
          "expiresIn"
        ]
      },
      "PlexPoll": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          }
        },
        "required": [
          "connected"
        ]
      },
      "Success": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "Departure": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "episode",
              "season",
              "show"
            ]
          },
          "watch": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "unknown"
            ]
          },
          "estimatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "watch",
          "estimatedAt",
          "url"
        ]
      },
      "Departures": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Departure"
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "recorded_history"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "scope",
          "updatedAt",
          "expiresAt"
        ]
      }
    }
  }
}
