                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putReminderPreferences",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReminderPreferences"
                }
