{
  "openapi": "3.0.3",
  "info": {
    "title": "Le Concierge API",
    "version": "0.1.0",
    "description": "Public Hub API. Bot /internal/discord is deliberately not proxied by the Hub. Protected media requires a verified Plex grant; Seerr additionally requires an administrator-verified mapping. Pagination is bounded; times are UTC RFC3339."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "getServices",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Services"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests": {
      "get": {
        "operationId": "getRequests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestPage"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/recent": {
      "get": {
        "operationId": "getRecent",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recent"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/preferences": {
      "get": {
        "operationId": "getPreferences",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePreferences",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceUpdate"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/plex/start": {
      "post": {
        "operationId": "startPlexLink",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexStart"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/plex/poll": {
      "post": {
        "operationId": "pollPlexLink",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexPoll"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/discord/start": {
      "get": {
        "operationId": "startDiscord",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to Discord or Hub; callback requires single-use state and the initiating browser cookie."
          },
          "default": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/discord/callback": {
      "get": {
        "operationId": "callbackDiscord",
        "security": [],
        "responses": {
          "303": {
            "description": "Redirect to Discord or Hub; callback requires single-use state and the initiating browser cookie."
          },
          "default": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-concierge_session",
        "description": "HttpOnly cookie; concierge_session for loopback development only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "discordId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plexId": {
            "type": "string"
          },
          "seerrId": {
            "type": "integer"
          },
          "notifications": {
            "type": "boolean"
          }
        },
        "required": [
          "discordId",
          "name",
          "notifications"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true
          },
          "admin": {
            "type": "boolean"
          },
          "plexConnected": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user"
        ]
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "watch",
              "read",
              "tools"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category"
        ]
      },
      "Services": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "discordLogin": {
            "type": "boolean"
          },
          "plexLink": {
            "type": "boolean"
          },
          "requests": {
            "type": "boolean"
          },
          "recent": {
            "type": "boolean"
          },
          "subscriptions": {
            "type": "boolean"
          },
          "notifications": {
            "type": "boolean"
          },
          "books": {
            "type": "boolean"
          },
          "monitoring": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "discordLogin",
          "plexLink",
          "requests",
          "recent",
          "subscriptions",
          "notifications",
          "books",
          "monitoring"
        ]
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "addedAt"
        ]
      },
      "Recent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "offset",
          "limit",
          "updatedAt"
        ]
      },
      "MediaRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "declined",
              "processing",
              "partial",
              "available",
              "unknown"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "mediaId": {
            "type": "integer"
          },
          "seasons": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "status",
          "createdAt",
          "mediaId",
          "seasons"
        ]
      },
      "RequestPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaRequest"
            }
          },
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "notifications": {
            "type": "boolean"
          },
          "notificationsAvailable": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "notifications",
          "notificationsAvailable",
          "timezone"
        ]
      },
      "PreferenceUpdate": {
        "type": "object",
        "properties": {
          "notifications": {
            "type": "boolean"
          }
        },
        "required": [
          "notifications"
        ]
      },
      "PlexStart": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "url",
          "expiresIn"
        ]
      },
      "PlexPoll": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          }
        },
        "required": [
          "connected"
        ]
      },
      "Success": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      }
    }
  }
}
