                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "multipleOf": 10
            }
          }
        ]
      },
      "post": {
        "operationId": "postSubscription",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
