          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceUpdate"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/auth/plex/start": {
      "post": {
        "operationId": "startPlexLogin",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexStart"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ],
        "description": "Anonymous Plex PIN flow; exact Origin required. The pending PIN is bound to a dedicated HttpOnly browser cookie. A session is issued only after Plex verifies access to the configured server."
      }
    },
    "/api/v1/auth/plex/poll": {
      "post": {
        "operationId": "pollPlexLogin",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlexPoll"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ],
        "description": "Anonymous Plex PIN flow; exact Origin required. The pending PIN is bound to a dedicated HttpOnly browser cookie. A session is issued only after Plex verifies access to the configured server."
      }
    },
