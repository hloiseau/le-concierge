            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal configured PUBLIC_ORIGIN. Browser sends this header automatically."
          }
        ]
      }
    },
    "/api/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
