              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionResult"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionInput"
              }
            }
          }
        },
        "description": "Origin must match PUBLIC_ORIGIN. Only the authenticated owner can follow; at most 100 follows."
      }
    },
    "/api/v1/subscriptions/{id}": {
      "delete": {
        "operationId": "deleteSubscription",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationOK"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Owner only; matching Origin required.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/extension-requests": {
      "get": {
        "operationId": "getExtensionRequests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionRequests"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "The owner’s 100 latest requests, retained for 90 days."
      },
      "post": {
        "operationId": "postExtensionRequest",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionRequest"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtensionRequestInput"
              }
            }
          }
        },
        "description": "Fresh authorized departure required, matching Origin. One request per owner/action/deadline, at most ten pending or created within 24h. Creates an administrative request without changing Maintainerr."
      }
    },
    "/api/v1/admin/extension-requests": {
      "get": {
        "operationId": "getAdminExtensionRequests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionRequests"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Configured administrator only; 100 oldest pending requests, including requester display name."
      },
      "put": {
        "operationId": "reviewExtensionRequest",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationOK"
                }
              }
            }
          },
          "default": {
            "description": "Error with stable code and French message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtensionReview"
              }
            }
          }
        },
        "description": "Configured administrator only, matching Origin. Records manual handling or refusal; does not modify Maintainerr."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-concierge_session",
        "description": "HttpOnly cookie; concierge_session for loopback development only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "discordId": {
            "type": "string",
            "description": "Optional Discord identity, linked after Plex login."
          },
          "name": {
            "type": "string"
          },
          "plexId": {
            "type": "string"
          },
          "seerrId": {
            "type": "integer"
          },
          "notifications": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "plexId",
          "notifications"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true
          },
          "admin": {
            "type": "boolean"
          },
          "plexConnected": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "watch",
              "read",
              "tools"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category"
        ],
        "additionalProperties": false
      },
      "Services": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "discordLogin": {
            "type": "boolean",
            "description": "Optional Discord account linking is configured; this does not authenticate access to the Hub."
          },
          "plexLink": {
            "type": "boolean",
            "description": "Plex sign-in is configured and required to enter the Hub."
          },
          "requests": {
            "type": "boolean"
          },
          "recent": {
            "type": "boolean"
          },
          "subscriptions": {
            "type": "boolean"
          },
          "notifications": {
            "type": "boolean",
            "description": "Private removal reminder inbox is configured. Optional Discord delivery has its separate discordDMs capability and explicit consent."
          },
          "books": {
            "type": "boolean"
          },
          "monitoring": {
            "type": "boolean"
          },
          "departures": {
            "type": "boolean",
            "description": "Personal recorded viewing history; automatic reminders remain separate."
          },
          "discordDMs": {
            "type": "boolean",
            "description": "Explicit opt-in Discord removal reminders are configured."
          },
