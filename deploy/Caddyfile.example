hub.example.com {
    encode zstd gzip
    # API traffic goes through the Hub proxy. Never expose /internal/discord.
    reverse_proxy 192.0.2.10:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}

concierge.example.com {
    @interaction path /interactions
    handle @interaction {
        reverse_proxy 192.0.2.10:8081
    }
    handle {
        respond "Not found" 404
    }
}
# Do not enable access logs containing OAuth callback query strings.
# If access logs are required, redact query parameters first.
