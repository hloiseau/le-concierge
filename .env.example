APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
LISTEN_ADDR=127.0.0.1:8080
BOT_LISTEN_ADDR=127.0.0.1:8081
DATABASE_PATH=data/concierge.db

# Discord Developer Portal: OAuth callback = PUBLIC_ORIGIN/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
# Manual bot --register, and the API when optional removal DMs are enabled.
DISCORD_BOT_TOKEN=
# Explicit server enable; each member must also opt in separately in the Hub.
DISCORD_DMS_ENABLED=false
# Generate a long random value; shared by API and bot, kept server-side.
BOT_API_SECRET=
BOT_API_URL=http://127.0.0.1:8080
ADMIN_DISCORD_IDS=

# Internal URLs reachable from the API container. Leave pairs empty to disable.
PLEX_URL=
PLEX_SERVER_ID=
SEERR_URL=
SEERR_API_KEY=

# Read-only sources for personal departures and opt-in removal reminders.
# Contracts verified for Maintainerr 3.30.1 and Tautulli 2.18.2.
MAINTAINERR_URL=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Optional scoped OPDS catalog; personal credentials are entered in the Hub.
# HTTPS required outside development. No shared administrator credentials.
GRIMMORY_URL=
# Optional personal Shelfmark request tracking; builtin login, no shared API key.
SHELFMARK_URL=

# Optional personal downloads. HTTPS and exact deployed contract build revision.
# Both blank disables the integration; see docs/downloadarr.md.
DOWNLOADARR_URL=
DOWNLOADARR_REVISION=

# Optional read-only host snapshot produced by tools/collect_metrics.py.
MONITORING_ENABLED=false
METRICS_FILE=

# Read-only administrator diagnostics, optional pairs.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# Explicitly published, expiring summaries; no automatic private channel export.
COMMUNITY_FEED_FILE=
COMMUNITY_FORUM_IDS=
ROADMAP_ISSUE_IDS=

# Only public HTTPS links. Empty links are displayed as "À connecter".
SERVICE_LINKS_JSON='{"plex":"https://app.plex.tv","seerr":"","downloadarr":"","torrent-watch":"","shelfmark":"","grimmory":""}'

# Secrets may instead use *_FILE (never both variants at once).
# DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# BOT_API_SECRET_FILE=/run/secrets/bot_api_secret
# SEERR_API_KEY_FILE=/run/secrets/seerr_api_key
# TAUTULLI_API_KEY_FILE=/run/secrets/tautulli_api_key
# RADARR_API_KEY_FILE=/run/secrets/radarr_api_key
# SONARR_API_KEY_FILE=/run/secrets/sonarr_api_key
