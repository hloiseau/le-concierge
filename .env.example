APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
LISTEN_ADDR=127.0.0.1:8080
BOT_LISTEN_ADDR=127.0.0.1:8081
DATABASE_PATH=data/concierge.db

# Discord Developer Portal: OAuth callback = PUBLIC_ORIGIN/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
# Required only by the manual bot --register command.
DISCORD_BOT_TOKEN=
# Generate a long random value; shared by API and bot, kept server-side.
BOT_API_SECRET=
BOT_API_URL=http://127.0.0.1:8080
ADMIN_DISCORD_IDS=

# Internal URLs reachable from the API container. Leave pairs empty to disable.
PLEX_URL=
PLEX_SERVER_ID=
SEERR_URL=
SEERR_API_KEY=

# Read-only source diagnostics; no reminders or personal departure list yet.
# Contracts verified for Maintainerr 3.30.1 and Tautulli 2.18.2.
MAINTAINERR_URL=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Only public HTTPS links. Empty links are displayed as "À connecter".
SERVICE_LINKS_JSON='{"plex":"https://app.plex.tv","seerr":"","downloadarr":"","torrent-watch":"","shelfmark":"","grimmory":""}'

# Secrets may instead use *_FILE (never both variants at once).
# DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
# BOT_API_SECRET_FILE=/run/secrets/bot_api_secret
# SEERR_API_KEY_FILE=/run/secrets/seerr_api_key
# TAUTULLI_API_KEY_FILE=/run/secrets/tautulli_api_key
